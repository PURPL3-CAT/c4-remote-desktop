{
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "26.15.3"
  },
  "name": "c4-ignition",
  "version": "1.0.0",
  "description": "",
  "main": "c4-core.js",
  "dependencies": {
    "debug": "^4.4.3",
    "env-paths": "^3.0.0",
    "graceful-fs": "^4.2.11",
    "ms": "^2.1.3",
    "peerjs": "1.5.2",
    "progress": "^2.0.3",
    "semver": "^7.8.5",
    "sumchecker": "^3.0.1",
    "undici": "^7.30.0",
    "undici-types": "^7.24.6"
  },
  "scripts": {
    "test": "node --test",
    "start": "electron .",
    "package:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts\\package-windows.ps1"
  },
  "build": {
    "appId": "com.c4ignition.app",
    "productName": "c4 Ignition",
    "directories": {
      "output": "release"
    },
    "files": [
      "**/*",
      "!test{,/**/*}",
      "!PACKAGING.md",
      "!requirements-input.txt",
      "!scripts{,/**/*}"
    ],
    "extraResources": [
      {
        "from": "build/python/c4-input",
        "to": "c4-input"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "c4-Ignition-setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs"
}
